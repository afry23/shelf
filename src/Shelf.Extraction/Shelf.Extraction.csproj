<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The only project that references the EPUB and PDF libraries (ADR 0005). PDFtoImage renders the cover of a PDF with PDFium;
       SkiaSharp encodes it (ADR 0010). Their native libraries come with the packages and land next to the binary. -->
  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="VersOne.Epub" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shelf.Core\Shelf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shelf.Extraction.Tests" />
  </ItemGroup>

</Project>

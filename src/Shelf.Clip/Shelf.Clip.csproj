<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The only project that reads web pages (ADR 0020): AngleSharp parses, SmartReader picks the article, ReverseMarkdown writes it. -->

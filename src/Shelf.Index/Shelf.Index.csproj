<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shelf.Core\Shelf.Core.csproj" />
    <ProjectReference Include="..\Shelf.Extraction\Shelf.Extraction.csproj" />
    <ProjectReference Include="..\Shelf.Organize\Shelf.Organize.csproj" />
  </ItemGroup>

  <!-- sqlite-vec (ADR 0004): vec0.* lands next to the executable; without it vectors use plain tables. -->
  <PropertyGroup>
    <VecRid>$(RuntimeIdentifier)</VecRid>
    <VecRid Condition="'$(VecRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</VecRid>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\vendor\sqlite-vec\$(VecRid)\vec0.*" Condition="Exists('..\..\vendor\sqlite-vec\$(VecRid)')"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shelf.Index.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>shelf</AssemblyName>
    <RootNamespace>Shelf.Cli</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Keep framework messages in English; no satellite resource folders next to the binary (ADR 0002). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shelf.Core\Shelf.Core.csproj" />
    <ProjectReference Include="..\Shelf.Index\Shelf.Index.csproj" />
    <ProjectReference Include="..\Shelf.Mcp\Shelf.Mcp.csproj" />
    <ProjectReference Include="..\Shelf.Semantic\Shelf.Semantic.csproj" />
    <ProjectReference Include="..\Shelf.Web\Shelf.Web.csproj" />
  </ItemGroup>

  <!-- The runtime feature switch that the Web SDK sets: without it the trimmer keeps MVC's model metadata and the AOT publish
       warns (IL2026, IL3050). It belongs to the executable, not to Shelf.Web (ADR 0008, finding 2). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.Mvc.ApiExplorer.IsEnhancedModelMetadataSupported" Value="false" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shelf.Cli.Tests" />
  </ItemGroup>

</Project>

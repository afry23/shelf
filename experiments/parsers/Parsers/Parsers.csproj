<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Variant=epub|pdf|all selects the libraries; one source tree, so the size delta per library is measurable. -->
    <Variant Condition="'$(Variant)' == ''">all</Variant>
    <AssemblyName>proto-parsers-$(Variant)</AssemblyName>
    <RootNamespace>Proto</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(Variant)' == 'epub' or '$(Variant)' == 'all'">$(DefineConstants);EPUB</DefineConstants>
    <DefineConstants Condition="'$(Variant)' == 'pdf' or '$(Variant)' == 'all'">$(DefineConstants);PDF</DefineConstants>
    <!-- CODEPAGES=true adds CodePagesEncodingProvider (size measurement only). -->
    <DefineConstants Condition="'$(CodePages)' == 'true'">$(DefineConstants);CODEPAGES</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Variant)' == 'epub' or '$(Variant)' == 'all'">
    <PackageReference Include="VersOne.Epub" />
  </ItemGroup>

  <ItemGroup Condition="'$(Variant)' == 'pdf' or '$(Variant)' == 'all'">
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
  </ItemGroup>

</Project>

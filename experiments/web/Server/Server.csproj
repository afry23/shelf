<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>proto-web</AssemblyName>
    <RootNamespace>Proto</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Svelte build output, embedded under the logical folder "ui". Requires `npm run build` first. -->
    <EmbeddedResource Include="..\Ui\dist\**\*" LinkBase="ui" />
  </ItemGroup>

</Project>

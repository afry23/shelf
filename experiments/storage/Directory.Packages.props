<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Explicit pin, same version as the transitive reference of Microsoft.Data.Sqlite 10.0.12. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>

</Project>
